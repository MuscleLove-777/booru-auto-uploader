# AIBooru (aibooru.online) - HTTP Basic Auth
AIBOORU_USERNAME=your_aibooru_username
AIBOORU_API_KEY=your_aibooru_api_key

# Gelbooru (gelbooru.com) - user_id + api_key
GELBOORU_USERNAME=your_gelbooru_user_id
GELBOORU_API_KEY=your_gelbooru_api_key

# Google Drive folder containing images
GDRIVE_FOLDER_ID_BOORU=your_google_drive_folder_id

# Google API Key (optional)
GOOGLE_API_KEY=your_google_api_key
